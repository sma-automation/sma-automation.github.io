    {
      "id": "9052fd9f-06ac-45fc-8625-0044353605c4",
      "name": "Zuordnung prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        560
      ],
      "parameters": {
        "jsCode": "try { const c=$('Auftrag beanspruchen').first().json;const a=$input.all().map(x=>x.json).filter(x=>x.produkt_id);if(a.length!==1)throw Error('PRODUCT_MAPPING');const p=a[0];const gid=(s,t)=>String(s).startsWith('gid://')?String(s):'gid://shopify/'+t+'/'+s;if(p.kunde_id!==c.kunde_id||p.produkt_id!==c.produkt_id||p.markt_konto_id!==c.markt_konto_id||gid(p.externe_variant_id,'ProductVariant')!==c.variant_id||p.sync_aktiv!==true)throw Error('PRODUCT_MAPPING');return [{json:{...p,product_gid:gid(p.externe_produkt_id,'Product'),ok:true}}]; } catch(e) { return [{json:{ok:false,code:String(e.message)}}]; }"
      }
    },
