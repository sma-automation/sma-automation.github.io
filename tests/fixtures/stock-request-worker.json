        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ query: 'mutation CustomerStockSet($input:InventorySetQuantitiesInput!,$key:String!) { inventorySetQuantities(input:$input) @idempotent(key:$key) { inventoryAdjustmentGroup { createdAt } userErrors { code field message } } }', variables: { input: $('Änderung vorbereiten').first().json.input, key: $('Auftrag beanspruchen').first().json.request_id } }) }}",
        "options": {
          "timeout": 12000
        }
      }
    },
    {
      "id": "8c8c217a-0d91-41b6-b1ed-59604f4e2ecc",
      "name": "Shopify-Ergebnis prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        848
      ],
      "parameters": {
        "jsCode": "const j=$json;if(j.error||j.errors?.length)return [{json:{status:'unknown',code:'SHOPIFY_RESPONSE_UNCERTAIN'}}];const r=j.data?.inventorySetQuantities;if(!r)return [{json:{status:'unknown',code:'SHOPIFY_RESPONSE_MISSING'}}];if(r.userErrors?.length)return [{json:{status:'failed',code:'SHOPIFY_REJECTED',errors:r.userErrors.map(x=>({code:x.code,message:x.message}))}}];if(!r.inventoryAdjustmentGroup)return [{json:{status:'unknown',code:'SHOPIFY_CONFIRMATION_MISSING'}}];return [{json:{status:'applied',code:'SHOPIFY_CONFIRMED',quantity:$('Auftrag beanspruchen').first().json.quantity}}];"
      }
