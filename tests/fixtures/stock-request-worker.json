      "id": "8c18fea4-7480-408e-a96e-64e20418dcef",
      "name": "Shopify-Bestand lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1680,
        560
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://' + $('Auftrag beanspruchen').first().json.shop_domain + '/admin/api/2026-07/graphql.json' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Shopify-Access-Token",
              "value": "={{ $('Access Token holen').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ query: 'query StockRequestSnapshot($id:ID!) { productVariant(id:$id) { id sku product { id } inventoryItem { id sku tracked variants(first:2) { nodes { id } pageInfo { hasNextPage } } inventoryLevels(first:250) { nodes { location { id isActive fulfillsOnlineOrders } quantities(names:[\"available\"]) { name quantity } } pageInfo { hasNextPage endCursor } } } } }', variables: { id: $('Auftrag beanspruchen').first().json.variant_id } }) }}",
        "options": {
          "timeout": 12000
        }
      }
    },
    {
      "id": "c85cb338-5544-4a5c-9f40-25abf794b0f4",
      "name": "Änderung vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        848
      ],
      "parameters": {
        "jsCode": "try { const c=$('Auftrag beanspruchen').first().json; const j=$json; if(j.error||j.errors?.length)throw Error('SHOPIFY_READ');const v=j.data?.productVariant;const m=$('Zuordnung prüfen').first().json;const item=v?.inventoryItem;if(!v||v.id!==c.variant_id||v.product?.id!==m.product_gid||v.sku!==c.sku||item?.sku!==c.sku)throw Error('SHOPIFY_PRODUCT_MAPPING');if(item.tracked!==true)throw Error('TRACKING_DISABLED');if(item.variants?.pageInfo?.hasNextPage!==false||item.variants.nodes.length!==1||item.variants.nodes[0].id!==v.id)throw Error('SHARED_INVENTORY_ITEM');if(item.inventoryLevels?.pageInfo?.hasNextPage!==false)throw Error('INCOMPLETE_LOCATIONS');const a=item.inventoryLevels.nodes.filter(x=>x.location?.isActive===true&&x.location?.fulfillsOnlineOrders===true);if(a.length!==1)throw Error('LOCATION_SELECTION_REQUIRED');const q=a[0].quantities.filter(x=>x.name==='available');if(q.length!==1||!Number.isSafeInteger(q[0].quantity))throw Error('INVALID_SHOPIFY_QUANTITY');if(!Number.isSafeInteger(c.quantity)||c.quantity<0||c.quantity>1000000)throw Error('INVALID_REQUEST_QUANTITY');const snapshot={quantity:c.quantity,from_quantity:q[0].quantity,inventory_item_id:item.id,location_id:a[0].location.id,variant_id:v.id,read_at:new Date().toISOString()};return [{json:{ok:true,...snapshot,input:{name:'available',reason:'correction',referenceDocumentUri:'gid://sma/Bestandsauftrag/'+c.request_id,quantities:[{inventoryItemId:item.id,locationId:a[0].location.id,quantity:c.quantity,changeFromQuantity:q[0].quantity}]}}}]; } catch(e) { return [{json:{ok:false,code:String(e.message)}}]; }"
      }
    },
