      "parameters": {
        "jsCode": "const raw=$input.first().json.credential_json??$input.first().json.datacredential_json;\nconst c=typeof raw==='string'?JSON.parse(raw):raw;\nif(typeof c?.client_id!=='string'||!c.client_id||typeof c?.client_secret!=='string'||!c.client_secret) throw Error('INVALID_CREDENTIAL');\nreturn [{json:{client_id:c.client_id,client_secret:c.client_secret},pairedItem:{item:0}}];"
