    {
      "parameters": {
        "jsCode": "const t=$input.first().json;\nif(typeof t.access_token!=='string'||!t.access_token) throw Error('MISSING_TOKEN');\nconst scopes=String(t.scope||'').split(',');if(!scopes.includes('read_orders')) throw Error('MISSING_READ_ORDERS');\nreturn [{json:{access_token:t.access_token},pairedItem:{item:0}}];"
      },
