        "jsCode": "const a=$('Marktkonto absichern').item.json;const rows=$input.all();\nif(rows.length!==1) throw Error('AMBIGUOUS_CREDENTIAL');const c=rows[0].json;\nif(c.kunde_id!==a.kunde_id || c.markt_konto_id!==a.markt_konto_id || c.markt!=='shopify' || c.credential_ref!==a.credential_ref || !c.credential_blob) throw Error('CREDENTIAL_MISMATCH');\nreturn [{json:c,pairedItem:{item:0}}];"
