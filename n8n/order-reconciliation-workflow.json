    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://'+$('Abgleich beanspruchen').item.json.shop_domain+'/admin/api/2026-07/graphql.json' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({query:\"query SMAOrderRecovery($after: String, $filter: String!, $first: Int!) { orders(first: $first, after: $after, sortKey: UPDATED_AT, query: $filter) { nodes { id name createdAt updatedAt displayFinancialStatus displayFulfillmentStatus currentTotalPriceSet { shopMoney { amount currencyCode } } } pageInfo { hasNextPage endCursor } } }\",variables:{first:50,after:null,filter:\"updated_at:<='\"+$('Abgleich beanspruchen').item.json.cutoff+\"'\"} }) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "variables",
                    "value": "={{ { ...$request.body.variables, after: $response.body?.data?.orders?.pageInfo?.endCursor || null } }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !!$response.body.errors?.length || $response.body.data?.orders?.pageInfo?.hasNextPage !== true }}",
              "limitPagesFetched": true,
              "maxRequests": 200,
              "requestInterval": 750
            }
          },
          "timeout": 20000
        }
      },
      "id": "e91af3c2-678a-428b-9d6f-278516516109",
      "name": "Shopify Seiten lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2640,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
