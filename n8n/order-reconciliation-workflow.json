    {
      "parameters": {
        "jsCode": "const claim=$('Abgleich beanspruchen').item.json;\nconst rows=$input.all();\nif(rows.length!==1) throw Error('AMBIGUOUS_ACCOUNT');\nconst a=rows[0].json;\nif(a.kunde_id!==claim.kunde_id || a.markt_konto_id!==claim.markt_konto_id || a.markt!=='shopify' || a.aktiv!==true || a.bestell_sync_aktiv!==true || a.verbindungs_status!=='verbunden' || String(a.shop_url||'').replace(/\\/$/,'')!=='https://'+claim.shop_domain || !a.credential_ref) throw Error('ACCOUNT_MISMATCH');\nreturn [{json:a,pairedItem:{item:0}}];"
      },
